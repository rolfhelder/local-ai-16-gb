{
  "name": "rolfhelder-local-ai-16-gb",
  "version": "0.1.0",
  "private": true,
  "description": "Setup checklist and tested Windows baseline for Pi + llama.cpp on a 16 GB GPU",
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "browser": "playwright-cli",
    "test": "node --test evals/policy.test.mjs evals/context-status.test.mjs evals/recall-grader.test.mjs evals/timings.test.mjs evals/runtime.test.mjs evals/local-token-budget.test.mjs evals/effort.test.mjs evals/effort-score.test.mjs evals/posix-launcher.test.mjs evals/doctor.test.mjs evals/acceptance.test.mjs evals/matched-evals.test.mjs evals/gpu-offload.test.mjs evals/installer.test.mjs evals/command-ui.test.mjs",
    "eval:tools": "node evals/run.mjs",
    "eval:hooks": "node evals/hooks.mjs",
    "eval:guard": "node evals/guard-integration.mjs",
    "eval:browser": "node evals/browser.mjs",
    "eval:worktrees": "node evals/worktrees.mjs",
    "eval:research": "node evals/research-live.mjs",
    "eval:context-limits": "node evals/context-limits.mjs",
    "eval:statusline": "node evals/statusline-tui.mjs",
    "eval:web": "node evals/web-tools.mjs",
    "eval:coding": "node evals/model-coding.mjs",
    "eval:coding-context": "node evals/coding-context.mjs",
    "eval:live": "node evals/live.mjs",
    "pia": "node scripts/pia.mjs",
    "pia:unix": "node scripts/pia-unix.mjs",
    "local-ai": "node scripts/pia.mjs",
    "local-ai:unix": "node scripts/pia-unix.mjs",
    "eval:acceptance": "node scripts/acceptance.mjs",
    "eval:coding-check": "node evals/matched-evals.mjs"
  },
  "dependencies": {
    "@arcanemachine/pi-web-search": "3.0.0",
    "@injaneity/pi-computer-use": "0.5.1",
    "@lincoln504/pi-research": "1.7.13",
    "@playwright/cli": "0.1.22",
    "pi-guard": "1.6.0",
    "pi-lsp-extension": "1.4.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0",
    "pi-coding-agent-test": "0.1.4",
    "typescript": "5.9.3",
    "typescript-language-server": "6.0.2"
  }
}
