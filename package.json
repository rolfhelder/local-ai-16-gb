{
  "name": "rolfhelder-pi-local-lab",
  "version": "0.1.0",
  "private": true,
  "description": "Windows local-model Pi research and reusable workflow prompts",
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "browser": "playwright-cli",
    "test": "node --test evals/policy.test.mjs",
    "eval:tools": "node evals/run.mjs",
    "eval:hooks": "node evals/hooks.mjs",
    "eval:guard": "node evals/guard-integration.mjs",
    "eval:browser": "node evals/browser.mjs",
    "eval:worktrees": "node evals/worktrees.mjs",
    "eval:research": "node evals/research-live.mjs",
    "eval:live": "node evals/live.mjs",
    "pia": "node scripts/pia.mjs"
  },
  "dependencies": {
    "@injaneity/pi-computer-use": "0.5.1",
    "@lincoln504/pi-research": "1.7.13",
    "@playwright/cli": "0.1.22",
    "pi-guard": "1.6.0",
    "pi-lsp-extension": "1.4.0"
  },
  "pi": {
    "prompts": [
      "./prompts"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0",
    "pi-coding-agent-test": "0.1.4",
    "typescript": "5.9.3",
    "typescript-language-server": "6.0.2"
  }
}
